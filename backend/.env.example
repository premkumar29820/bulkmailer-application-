# The port our backend server runs on
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/bulk_mail_app

# Simple admin login (no database, just checked against these values)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Comma-separated frontend origins. Do not add a trailing slash.
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Optional SMTP override. If omitted, the app reads user/pass from MongoDB bulkmail collection.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=